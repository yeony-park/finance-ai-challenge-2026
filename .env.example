# LLM (없으면 fake 모드로 동작 — 키 없이도 전체 시스템 실행 가능)
# Vercel AI Gateway 키 (권장: 모델 폴백·관측 지원)
AI_GATEWAY_API_KEY=
# 또는 Anthropic 직접 연결
ANTHROPIC_API_KEY=
# 모델 오버라이드 (기본: anthropic/claude-sonnet-5)
SPINE_MODEL=
# claim 추출 모델 오버라이드 (기본: SPINE_MODEL과 동일). 키가 없으면 fake 추출기로 완주한다
VERIFY_EXTRACT_MODEL=
# 공통 PDF 후보·부동산 상품 구조화 추출 모델 (Gateway 기본 openai/gpt-5.6-luna, OpenAI 직결 기본 gpt-5.6-luna)
KNOWLEDGE_EXTRACT_MODEL=
# 명시 knowledge:extract CLI의 실패/스캔 페이지 Vision 전사. 기본 OFF
KNOWLEDGE_OCR_ENABLED=false
# Vision 전사 모델 (기본: gpt-5.6-luna)
KNOWLEDGE_OCR_MODEL=
# 눈높이 서술(narrative) 생성 모델 오버라이드 (기본: 메인/ OpenAI 서술 모델). 키 없으면 fake 서술로 완주
VERIFY_NARRATIVE_MODEL=

# OpenDART 공시검색 API (opendart.fss.or.kr 발급, 자동승인)
DART_API_KEY=
# 공공데이터포털 (data.go.kr 발급, 자동승인 — 축산물이력제 15058923 · 등급판정/경락가 15058822 · 실거래가 · 건축HUB 건축물대장 15134735 공용)
DATA_GO_KR_API_KEY=
# 국토교통부 실거래가 RTMS 전용 키 (설정 시 우선, 없으면 DATA_GO_KR_API_KEY 사용)
RTMS_API_KEY=
# 국토교통부 건축물대장 표제부 조회 전용 키 (data.go.kr 15134735)
BUILDING_HUB_API_KEY=
# 한국은행 ECOS StatisticSearch 기준금리(722Y001) 전용 키
ECOS_API_KEY=
# 한국부동산원 R-ONE 키 — 상업용 공실률·임대료의 정확한 표 코드 확정 전 보류(호출하지 않음)
RONE_API_KEY=
# 농식품부 가축질병 발생 API 수집 스크립트 전용 (scripts/collect-mafra-disease-api.mjs, 런타임 미사용)
MAFRA_API_KEY=
# 카카오맵 JavaScript 키 — 한우·한돈 리포트 질병 맥락 지도. 비어 있으면 지도 영역을 렌더하지 않는다.
# 카카오 개발자 콘솔 플랫폼 설정 Web 도메인에 배포 도메인(https://jeom-jeom.vercel.app) 등록 필수. Vercel Production 환경변수로 설정.
KAKAO_JAVASCRIPT_KEY=

# OpenAI 직결 (AI_GATEWAY_API_KEY 없을 때 이 키로 claim 추출 — 모델 기본 gpt-4.1-mini, VERIFY_EXTRACT_MODEL로 변경)
OPENAI_API_KEY=
# 로컬 SQLite semantic 검색. 기본 OFF이며 knowledge:embed --apply도 OPENAI_API_KEY가 있어야 실행됩니다.
# 임베딩 모델은 text-embedding-3-small(1536차원)로 고정하며 환경변수 override를 지원하지 않습니다.
KNOWLEDGE_SEMANTIC_ENABLED=false
# 공개 API의 AI planner/embedding/답변 공통 운영 opt-in. 기본 OFF.
# 프로세스 메모리 gate는 다중 인스턴스를 보호하지 않으므로 외부 전송 고지·동의,
# 분산 burst 제한과 전역 일일 비용상한을 배포 인프라에 구성한 뒤에만 true로 설정합니다.
KNOWLEDGE_RUNTIME_AI_ENABLED=false
# 홈 생성 답변과 상품 근거 설명 공통 feature flag. 위 운영 opt-in도 함께 true여야 합니다.
LIVE_EVIDENCE_ENABLED=false
# 근거질의 실시간 설명 모델 오버라이드 (기본: gpt-4.1-mini, OPENAI_API_KEY가 없으면 근거만 반환)
OPENAI_MODEL=
# 근거질의 추출형 답변 모델. 미설정 시 OPENAI_MODEL 또는 gpt-4.1-mini
KNOWLEDGE_ANSWER_MODEL=
# 상품별 1~2문장 AI 검증 요약 모델. 미설정 시 KNOWLEDGE_ANSWER_MODEL, OPENAI_MODEL, gpt-5.6-luna 순으로 사용
AI_SUMMARY_MODEL=

# AI 호출 전역 일일 예산·킬스위치 (06 §1 게이트 2·3) — 검색 플래너·근거 질의·미술품 Copilot live 호출이 공유한다.
# KV(Upstash Redis REST, Vercel 통합 시 KV_REST_API_URL/KV_REST_API_TOKEN 자동 주입)가 있으면 전역 카운터 `ai-budget:global:<일 인덱스>`로
# 집계하고, 없으면 인스턴스별 인메모리 카운터로 정직 폴백한다. KV가 설정됐는데 실패하면 AI 호출을 잠근다(레이트리밋과 반대).
# 일일 허용 요청 수. 미설정이면 100. 0이면 모든 AI 호출을 정적 경로로 강등한다.
AI_DAILY_REQUEST_BUDGET=
# 배포 외부 킬스위치: KV 키 `ai:kill-switch`에 1을 넣으면 재배포 없이 AI 호출을 차단한다(0·false·off·빈 값은 해제).
# 아래 환경변수는 KV 없는 환경용 보조 스위치이며 바꾸면 재배포가 필요하다.
AI_KILL_SWITCH=

# 정정 감시 크론 (GET /api/cron/monitor) 인증 — Vercel 프로젝트 환경변수로 설정.
# 미설정이면 크론 라우트는 503으로 정직하게 거절한다(감시 미실행).
CRON_SECRET=

# 정정 감지 이벤트 적재용 Vercel Blob 토큰 (Blob 스토어 연결 시 자동 주입).
# 미설정이면 이벤트를 저장하지 않고 크론 응답 본문에만 담아 반환한다.
BLOB_READ_WRITE_TOKEN=

# AWS RDS PostgreSQL 18 + pgvector (ap-northeast-2, 2026-08-31 이전 — docs/spec/09 §2 · contracts/storage.md)
# 미설정이면 file 모드 — DB 리포지토리 fake 트윈이 data/ JSON으로 완주한다(빌드·테스트·verify는 키 없이 그린).
# 풀러 없음 — 두 변수 모두 같은 RDS 엔드포인트(5432)를 가리키되 자격증명(역할)이 다르다. sslmode=require 필수(rds.force_ssl).
#   DATABASE_URL        — 런타임 전용 제한 역할(jeomjeom_rag_ro: RAG SELECT + 공개 상품 열 SELECT + 이력 INSERT, db/roles.sql로 생성).
#                         원장 쓰기·마이그레이션 권한은 부여하지 않는다.
#                         미설정이면 file 모드.
DATABASE_URL=
#   DATABASE_URL_DIRECT — 마스터(RW) 자격증명, CLI 전용(db:migrate·db:ingest·db:seed·db:export).
#                         미설정이면 db:* 스크립트가 not_configured로 정직 종료한다.
#   형식: postgres://<user>:<password>@<endpoint>:5432/jeomjeom?sslmode=require
DATABASE_URL_DIRECT=
