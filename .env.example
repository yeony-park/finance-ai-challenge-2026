# 이 파일에는 실제 인증키를 넣지 않는다.
# 로컬 `.env`가 없을 때 복사한 뒤 필요한 API key만 입력한다.
# 빈 값으로 두면 해당 실시간 출처는 연결되지 않고 검증된 저장본을 사용한다.

# 국토교통부 상업·업무용 실거래가 OpenAPI
COMMERCIAL_API_KEY=

# 국토교통부 토지 실거래가 OpenAPI
LAND_API_KEY=

# 건축HUB 건축물대장 표제부 OpenAPI
BUILDING_API_KEY=

# VWorld NED API
VWORLD_API_KEY=

# OpenDART API
DART_API_KEY=

# 선택 설정 : VWorld에 등록한 domain이 기본값과 다를 때만 활성화한다.
# VWORLD_DOMAIN=http://localhost:8000
# Server-only OpenAI configuration for the art investment AI service
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_MODE=demo
