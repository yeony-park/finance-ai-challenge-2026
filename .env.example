# Server-only API credentials. Never prefix these with NEXT_PUBLIC_.

# P0: OpenDART disclosure list, company codes, and original filing documents
OPENDART_API_KEY=

# P0: one data.go.kr key; request access to datasets 15058923 and 15058822 separately
DATA_GO_KR_SERVICE_KEY=
# 축산물품질평가원_축산물통합이력정보
# 축산물품질평가원_축산물등급판정정보

# The official KAPE endpoint currently uses HTTP. Enable only for an approved server-side prototype call.
KAPE_ALLOW_INSECURE_HTTP=false

# P1: optional dynamic livestock-disease monitoring (static MAFRA files are enough for the MVP)
MAFRA_API_KEY=

# Optional: evidence-grounded extraction and explanation after deterministic checks are connected
OPENAI_API_KEY=
OPENAI_MODEL=
