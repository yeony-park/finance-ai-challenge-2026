{
  "name": "finance-ai-challenge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "knowledge:index": "tsx src/lib/knowledge/index-cli.ts",
    "knowledge:extract": "tsx --env-file-if-exists=.env src/lib/knowledge/extract-cli.ts",
    "knowledge:derive": "tsx --env-file-if-exists=.env src/lib/knowledge/derive-cli.ts",
    "knowledge:derived:check": "tsx src/lib/knowledge/derive-cli.ts --check",
    "knowledge:pig-filing:build": "tsx src/lib/verify/dart/build-pig-filing-artifact-cli.ts",
    "knowledge:filing-corpus:build": "tsx src/lib/knowledge/filing-corpus-cli.ts --build",
    "knowledge:filing-corpus:check": "tsx src/lib/knowledge/filing-corpus-cli.ts",
    "knowledge:onboarding:preflight": "tsx src/lib/verify/dart/onboarding-preflight-cli.ts",
    "knowledge:onboarding:audit": "tsx src/lib/verify/dart/onboarding-build-audit-cli.ts",
    "knowledge:embed": "tsx --env-file-if-exists=.env src/lib/knowledge/local-rag/index-cli.ts",
    "predev": "npm run knowledge:onboarding:audit && npm run knowledge:filing-corpus:check && npm run knowledge:index && npm run knowledge:derived:check",
    "dev": "next dev",
    "prebuild": "npm run knowledge:onboarding:audit && npm run knowledge:filing-corpus:check && npm run knowledge:index && npm run knowledge:derived:check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:watch": "vitest",
    "redteam": "tsx src/lib/spine/redteam/cli.ts",
    "verify": "tsx src/lib/verify/cli.ts",
    "narrative": "tsx --env-file-if-exists=.env src/lib/verify/narrative/cli.ts",
    "verify:live": "tsx --env-file-if-exists=.env src/lib/verify/cli.ts",
    "verify:collect": "tsx --env-file-if-exists=.env src/lib/verify/dart/collect-cli.ts",
    "replay:actual": "tsx --env-file-if-exists=.env src/lib/verify/amend/actual-replay-cli.ts",
    "verify:realestate": "tsx src/lib/verify/real-estate-cli.ts",
    "reference:collect": "tsx --env-file-if-exists=.env src/lib/verify/reference/auction-collect-cli.ts",
    "reference:rtms": "tsx --env-file-if-exists=.env src/lib/verify/reference/rtms-collect-cli.ts",
    "reference:ecos": "tsx --env-file-if-exists=.env src/lib/verify/reference/ecos-collect-cli.ts",
    "reference:building-hub": "tsx --env-file-if-exists=.env src/lib/verify/reference/building-hub-collect-cli.ts",
    "reference:building": "tsx --env-file-if-exists=.env src/lib/verify/reference/building-register-collect-cli.ts",
    "reference:mafra-asf": "node scripts/collect-mafra-asf.mjs",
    "reference:mafra-fmd": "node scripts/collect-mafra-fmd.mjs",
    "reference:mafra-disease-api": "node --env-file=.env scripts/collect-mafra-disease-api.mjs",
    "reference:korea-outline": "node scripts/collect-korea-outline.mjs",
    "track-record": "tsx --env-file-if-exists=.env src/lib/verify/track-record/cli.ts",
    "watch:refresh": "tsx --env-file-if-exists=.env src/lib/verify/amend/monitor-cli.ts",
    "goldset:prelabel": "tsx src/lib/verify/goldset/cli.ts prelabel",
    "goldset:score": "tsx src/lib/verify/goldset/cli.ts score",
    "db:migrate": "tsx --env-file-if-exists=.env src/lib/db/cli/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/lib/db/cli/seed.ts",
    "db:ingest": "tsx --env-file-if-exists=.env src/lib/db/cli/ingest.ts",
    "db:export": "tsx --env-file-if-exists=.env src/lib/db/cli/export.ts",
    "data:manifest": "node scripts/update-data-manifest.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.41",
    "@napi-rs/canvas": "1.0.8",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.44",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "motion": "^13.1.0",
    "next": "^16.3.1",
    "pdfjs-dist": "6.2.108",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cfb": "^1.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
